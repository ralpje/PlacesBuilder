{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "6043476357697595568"
    }
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "metadata": {
        "description": "Globally unique web app name. The site becomes https://<siteName>.azurewebsites.net. Lowercase letters, digits and hyphens."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for all resources."
      }
    },
    "planSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "P0v3",
        "P1v3"
      ],
      "metadata": {
        "description": "App Service plan size. B1 is enough for a handful of users."
      }
    },
    "appVersion": {
      "type": "string",
      "defaultValue": "v0.3.1",
      "metadata": {
        "description": "Release of Places Builder to run, for example v0.1.3. Releases are published on GitHub."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "[format('https://github.com/ralpje/placesbuilder/releases/download/{0}/placesbuilder-{1}.zip', parameters('appVersion'), parameters('appVersion'))]",
      "metadata": {
        "description": "URL of the app package (zip). Normally derived from appVersion. The app runs straight from this file and fetches it again at every restart."
      }
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Client ID of an existing Entra app registration. Leave empty to run scripts/configure-auth.ps1 after deployment, which creates it for you."
      }
    },
    "entraClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Client secret for the app registration above. Only needed together with entraClientId."
      }
    },
    "allowedGroupIds": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated Entra group object IDs allowed to use the app. Needs the groups claim on the app registration."
      }
    },
    "allowedUserIds": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated Entra user object IDs allowed to use the app."
      }
    },
    "allowAnyTenantUser": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Let every user of your tenant in. Only set this when the enterprise application has \"Assignment required\" = Yes. With no group, user or this switch the app denies everyone."
      }
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id, parameters('siteName')), 6)]",
    "planName": "[format('plan-{0}', parameters('siteName'))]",
    "storageName": "[toLower(take(format('st{0}{1}', replace(parameters('siteName'), '-', ''), variables('suffix')), 24))]",
    "mapsName": "[format('maps-{0}', parameters('siteName'))]",
    "containerName": "imdf",
    "storageBlobDataContributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "mapsDataReader": "423170ca-a8f6-4b0f-8487-9e4eb8f49bfa",
    "hasAuth": "[and(not(empty(parameters('entraClientId'))), not(empty(parameters('entraClientSecret'))))]",
    "authSettings": "[if(variables('hasAuth'), createObject('MICROSOFT_PROVIDER_AUTHENTICATION_SECRET', parameters('entraClientSecret')), createObject())]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        },
        "isVersioningEnabled": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', variables('containerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Maps/accounts",
      "apiVersion": "2023-06-01",
      "name": "[variables('mapsName')]",
      "location": "global",
      "sku": {
        "name": "G2"
      },
      "kind": "Gen2",
      "properties": {
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('planSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "NODE|24-lts",
          "appCommandLine": "node server/index.mjs",
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "healthCheckPath": "/healthz"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('siteName'), 'appsettings')]",
      "properties": "[union(createObject('WEBSITE_RUN_FROM_PACKAGE', parameters('packageUrl'), 'NODE_ENV', 'production', 'STORAGE_CONTAINER', variables('containerName'), 'STORAGE_ACCOUNT_URL', reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob, 'BASEMAP', 'azure', 'AZURE_MAPS_CLIENT_ID', reference(resourceId('Microsoft.Maps/accounts', variables('mapsName')), '2023-06-01').uniqueId, 'ALLOWED_GROUP_IDS', parameters('allowedGroupIds'), 'ALLOWED_USER_IDS', parameters('allowedUserIds'), 'ALLOW_ANY_AUTHENTICATED', if(parameters('allowAnyTenantUser'), '1', '0'), 'ALLOWED_TENANT_IDS', tenant().tenantId), variables('authSettings'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Maps/accounts', variables('mapsName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "condition": "[variables('hasAuth')]",
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('siteName'), 'authsettingsV2')]",
      "properties": {
        "platform": {
          "enabled": true,
          "runtimeVersion": "~1"
        },
        "globalValidation": {
          "requireAuthentication": true,
          "unauthenticatedClientAction": "RedirectToLoginPage",
          "redirectToProvider": "azureactivedirectory",
          "excludedPaths": [
            "/healthz"
          ]
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "openIdIssuer": "[format('{0}{1}/v2.0', environment().authentication.loginEndpoint, tenant().tenantId)]",
              "clientId": "[parameters('entraClientId')]",
              "clientSecretSettingName": "MICROSOFT_PROVIDER_AUTHENTICATION_SECRET"
            },
            "validation": {
              "allowedAudiences": [
                "[format('api://{0}', parameters('entraClientId'))]",
                "[parameters('entraClientId')]"
              ]
            }
          }
        },
        "login": {
          "tokenStore": {
            "enabled": false
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/config', parameters('siteName'), 'appsettings')]",
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.Web/sites', parameters('siteName')), variables('storageBlobDataContributor'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributor'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('siteName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Maps/accounts', variables('mapsName'))]",
      "name": "[guid(resourceId('Microsoft.Maps/accounts', variables('mapsName')), resourceId('Microsoft.Web/sites', parameters('siteName')), variables('mapsDataReader'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('mapsDataReader'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('siteName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Maps/accounts', variables('mapsName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]"
      ]
    }
  ],
  "outputs": {
    "siteName": {
      "type": "string",
      "value": "[parameters('siteName')]"
    },
    "siteUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('siteName')), '2023-12-01').defaultHostName)]"
    },
    "storageAccount": {
      "type": "string",
      "value": "[variables('storageName')]"
    }
  }
}